# String de conexão do PostgreSQL no NeonDB (Neon Console > Connection Details)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Driver de conexão: "neon" (WebSocket/443, padrão) ou "pg" (TCP/5432)
DB_DRIVER=neon
# "true" executa as migrations pendentes automaticamente ao iniciar o servidor
DB_MIGRATIONS_RUN=false

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=1d

PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
